    border: 1px solid red;
}
QPushButton:hover {
    color: white;
    background-color: red;
}
QPushButton:checked {
    background-color: red;
	color: white;
}
QPushButton:pressed {
    background-color: rgb(255, 73, 73);
	border: 1px solid rgb(255, 73, 73);
}</string>
           </property>
           <property name="text">
            <string>Cancel</string>
           </property>
